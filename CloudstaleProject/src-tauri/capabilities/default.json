{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "com.cloudstale.app",
  "description": "Application for LLMs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "updater:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://localhost:11434"
        }
      ]
    },
    "fs:default"
  ]
}